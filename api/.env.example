# Copier ce fichier en .env (cp .env.example .env) puis adapter les valeurs.
# Le fichier .env ne doit JAMAIS être commité.

# Base SQLite (chemin relatif au dossier api/prisma/)
DATABASE_URL="file:./dev.db"

# Port de l'API
PORT=3001

# Secret de signature des JWT (OBLIGATOIRE, 16 caractères minimum).
# Générer une valeur aléatoire :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="remplacer-par-un-secret-long-et-aleatoire"

# Durée de vie d'une session (ex : 1d, 12h)
JWT_EXPIRES_IN="1d"

# Adresse(s) du site autorisées à appeler l'API, séparées par des virgules.
# En production : l'adresse HTTPS réelle du site.
CORS_ORIGIN="http://localhost:3000"

# Nombre de proxys devant l'API (0 en local ; 1 derrière Nginx sur le VPS)
TRUST_PROXY=0

# Compte administrateur créé par "npm run db:seed"
ADMIN_EMAIL="admin@startgen-mons.local"
ADMIN_PASSWORD="ChangeMoi-123"
ADMIN_NOM="Admin"
ADMIN_PRENOM="StartGen"
